<div 
    class="richtext page-width page-width--full"
    style="
        --padding-top: {{ section.settings.padding_top }}rem;
        --padding-bottom: {{ section.settings.padding_bottom }}rem;
        --padding-inner: {{ section.settings.padding_inner }}rem;
        --section-bg: {{ section.settings.section_bg }};
        --inner-bg: {{ section.settings.inner_bg }};
    "
    >
    <div class="richtext__inner page-width">
        <div class="richtext__content">
            {% for block in section.blocks %}
                <div class="richtext__blocks" {{ block.shopify_attributes }}>
                    {% case block.type %}
                      {% when "caption" %}
                        {% if block.settings.caption != blank %}
                          <p>{{ block.settings.caption }}</p>
                        {% endif %}
                      {% when "heading" %}
                        {% if block.settings.heading != blank %}
                            <h2>{{ block.settings.heading }}</h2>
                        {% endif %}
                      {% when "sub_heading" %}
                          {% if block.settings.sub_heading != blank %}
                            <h4>{{ block.settings.sub_heading }}</h4>
                        {% endif %}
                      {% when "description" %}
                        {% if block.settings.description != blank %}
                            {{ block.settings.description }}
                        {% endif %}
                      {% when "buttons" %}
                        <div class="richtext__blocks-buttons">
                            {% if block.settings.primary_btn_text != blank %}
                                <a class="btn" href="{{ block.settings.primary_btn_link }}">{{ block.settings.primary_btn_text }}</a>
                            {% endif %}
                             {% if block.settings.secondary_btn_text != blank %}
                                <a class="btn btn--secondary" href="{{ block.settings.secondary_btn_link }}">{{ block.settings.secondary_btn_text }}</a>
                            {% endif %}
                        </div>
                    {% endcase %}
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{% schema %}
{
    "name": "Richtext",
    "tag": "section",
    "settings": [
        {
            "type": "header",
            "content": "Color"
        },
        {
            "type": "color",
            "id": "section_bg",
            "label": "Section background",
            "default": "#fff",
            "info": "Full bleed background color"
        },
        {
            "type": "color",
            "id": "inner_bg",
            "label": "Inner content background",
            "default": "#fff",
            "info": "Inner container background color"
        },
        {
            "type": "color",
            "id": "button_bg_primary",
            "label": "Primary button background color",
            "default": "#000"
        },
        {
            "type": "color",
            "id": "button_bg_secondary",
            "label": "Secondary button background color",
            "default": "#000"
        },
        {
            "type": "color",
            "id": "button_text_primary",
            "label": "Primary button text color",
            "default": "#fff"
        },
        {
            "type": "color",
            "id": "button_text_secondary",
            "label": "Secondary button text color",
            "default": "#fff"
        },
        {
            "type": "header",
            "content": "Spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "label": "Padding top",
            "min": 0,
            "max": 10,
            "step": 1,
            "unit": "rem",
            "default": 3
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "label": "Padding bottom",
            "min": 0,
            "max": 10,
            "step": 1,
            "unit": "rem",
            "default": 3
        },
        {
            "type": "range",
            "id": "padding_inner",
            "label": "Padding top/bottom",
            "min": 0,
            "max": 10,
            "step": 1,
            "unit": "rem",
            "default": 3,
            "info": "Padding top and bottom for the inner container"
        }
    ],
    "blocks": [
        {
            "type": "caption",
            "name": "Caption",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "caption",
                    "label": "Caption",
                    "default": "Caption-Eyebrow Text"
                }
            ]
        },
        {
            "type": "heading",
            "name": "Heading",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Your awesome heading text goes here."
                }
            ]
        },
        {
            "type": "sub_heading",
            "name": "Sub-heading",
            "limit": 1,
            "settings": [
                {
                    "type": "textarea",
                    "id": "sub_heading",
                    "label": "Sub-heading",
                    "default": "This is the place to enter a relevant sub-heading text."
                }
            ]
        },
        {
            "type": "description",
            "name": "Description",
            "limit": 1,
            "settings": [
                {
                    "type": "richtext",
                    "id": "description",
                    "label": "Description",
                    "default": "<p>This is your changes to pursuade your customers by explaining them about the heading.</p>"
                }
            ]
        },
        {
            "type": "buttons",
            "name": "Buttons",
            "limit": 1,
            "settings": [
                {
                    "type": "text",
                    "id": "primary_btn_text",
                    "label": "Primary btn text",
                    "default": "Shop now"
                },
                {
                    "type": "text",
                    "id": "secondary_btn_text",
                    "label": "Secondary btn text",
                    "default": "Learn more"
                },
                {
                    "type": "url",
                    "id": "primary_btn_link",
                    "label": "Primary button link",
                    "default": "/collections/all"
                },
                {
                    "type": "url",
                    "id": "secondary_btn_link",
                    "label": "Secondary button link",
                    "default": "/collections/all"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Richtext",
            "blocks": [
                {
                    "type": "caption"
                },
                {
                    "type": "heading"
                },
                {
                    "type": "sub_heading"
                },
                {
                    "type": "description"
                },
                {
                    "type": "buttons"
                }
            ]
        }
    ]
}
{% endschema %}