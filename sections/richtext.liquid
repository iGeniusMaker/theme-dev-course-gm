<div
  class="color-scheme color-{{ section.settings.section_bg.id }} richtext page-width page-width--full"
  style="
    --padding-top: {{ section.settings.padding_top }}rem;
    --padding-bottom: {{ section.settings.padding_bottom }}rem;
    --padding-inner: {{ section.settings.padding_inner }}rem;
  "
>
  <div class="color-scheme color-{{ section.settings.inner_bg.id }} richtext__inner page-width">
    <div class="richtext__content">
      <h1>{{ 'general.welcome_message' | t }}</h1>
      {% for block in section.blocks %}
        <div class="richtext__blocks" {{ block.shopify_attributes }}>
          {% case block.type %}
            {% when 'caption' %}
              {% if block.settings.caption != blank %}
                <p class="caption">{{ block.settings.caption }}</p>
              {% endif %}
            {% when 'heading' %}
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}
            {% when 'sub_heading' %}
              {% if block.settings.sub_heading != blank %}
                <h4>{{ block.settings.sub_heading }}</h4>
              {% endif %}
            {% when 'description' %}
              {% if block.settings.description != blank %}
                {{ block.settings.description }}
              {% endif %}
            {% when 'buttons' %}
              <div class="richtext__blocks-buttons">
                {% if block.settings.primary_btn_text != blank %}
                  <a class="btn btn-primary" href="{{ block.settings.primary_btn_link }}">
                    {{- block.settings.primary_btn_text -}}
                  </a>
                {% endif %}
                {% if block.settings.secondary_btn_text != blank %}
                  <a class="btn btn-outline" href="{{ block.settings.secondary_btn_link }}">
                    {{- block.settings.secondary_btn_text -}}
                  </a>
                {% endif %}
              </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.richtext.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.general.color"
    },
    {
      "type": "color_scheme",
      "id": "section_bg",
      "label": "Section background",
      "default": "scheme-1",
      "info": "Full bleed background color"
    },
    {
      "type": "color_scheme",
      "id": "inner_bg",
      "label": "Inner content background",
      "default": "scheme-2",
      "info": "Inner container background color"
    },
    {
      "type": "header",
      "content": "t:sections.general.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.general.padding_top",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.general.padding_bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_inner",
      "label": "Padding top/bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "default": 3,
      "info": "Padding top and bottom for the inner container"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Caption",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Caption-Eyebrow Text"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your awesome heading text goes here."
        }
      ]
    },
    {
      "type": "sub_heading",
      "name": "Sub-heading",
      "limit": 1,
      "settings": [
        {
          "type": "textarea",
          "id": "sub_heading",
          "label": "Sub-heading",
          "default": "This is the place to enter a relevant sub-heading text."
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>This is your changes to pursuade your customers by explaining them about the heading.</p>"
        }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "primary_btn_text",
          "label": "Primary btn text",
          "default": "Shop now"
        },
        {
          "type": "text",
          "id": "secondary_btn_text",
          "label": "Secondary btn text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "primary_btn_link",
          "label": "Primary button link",
          "default": "/collections/all"
        },
        {
          "type": "url",
          "id": "secondary_btn_link",
          "label": "Secondary button link",
          "default": "/collections/all"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.richtext.name",
      "blocks": [
        {
          "type": "caption"
        },
        {
          "type": "heading"
        },
        {
          "type": "sub_heading"
        },
        {
          "type": "description"
        },
        {
          "type": "buttons"
        }
      ]
    }
  ]
}
{% endschema %}
