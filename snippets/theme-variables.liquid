{% style %}
    {{ settings.body_font | font_face: font_display: "swap" }}
    {{ settings.heading_font | font_face: font_display: "swap" }}
  :root {
    --page-width: {{ settings.page_width | divided_by: 16.0 }}rem;
    --page-padding-mobile: {{ settings.page_padding }}px;
    --page-padding-desktop: {{ settings.page_padding_desktop }}px;
    --body-font: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
    --body-font-style: {{ settings.body_font.style }};
    --body-font-weight: {{ settings.body_font.weight }};
    --heading-font: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
    --heading-font-style: {{ settings.heading_font.style }};
    --heading-font-weight: {{ settings.heading_font.weight }};
    --font-size-base: 1rem;

    --global-border-radius: {{ settings.border_radius }}px;

    {% assign default_scheme = settings.color_schemes | first %}

      --color-background: {{ default_scheme.settings.background | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-background-gradient: {{ default_scheme.settings.background_gradient | default: 'none' }};
      --color-text: {{ default_scheme.settings.text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-accent: {{ default_scheme.settings.accent | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-bg: {{ default_scheme.settings.button_bg | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-text: {{ default_scheme.settings.button_text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-border: {{ default_scheme.settings.button_border | color_to_rgb | remove: 'rgb(' | remove: ')' }};

  }

  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-background-gradient: {{ scheme.settings.background_gradient | default: 'none' }};
      --color-text: {{ scheme.settings.text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-accent: {{ scheme.settings.accent | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-bg: {{ scheme.settings.button_bg | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-text: {{ scheme.settings.button_text | color_to_rgb | remove: 'rgb(' | remove: ')' }};
      --color-button-border: {{ scheme.settings.button_border | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    }
  {% endfor %}
{% endstyle %}
