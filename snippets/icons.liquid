{% doc %}
  Icons snippet using LUCIDE DEV svg icons

  @param {string} icon_name - Name of the svg icon
  @param {number} [icon_size] - Width and height of the icon
  @param {number} [icon_stroke] - Stroke of the icon
  @param {string} [extra_class] - Add an extra class to the icon

  @example
  {% render 'icons', icon_name: 'chevron-down', icon_size: 22, icon_stroke: 1.5, extra_class: 'another-class' %}

{% enddoc %}

<svg xmlns="http://www.w3.org/2000/svg" 
    width="{{ icon_size | default: 24 }}" 
    height="{{ icon_size | default: 24 }}" 
    viewBox="0 0 24 24" 
    fill="none" 
    stroke="currentColor" 
    stroke-width="{{ icon_stroke | default: 2 }}" 
    stroke-linecap="round" 
    stroke-linejoin="round" 
    class="icon-{{ icon_name | escape }}{% if extra_class %} {{ extra_class | escape }}{% endif %}"
>

    {% case icon_name %}
      {% when "chevron-down" %}
        <path d="m6 9 6 6 6-6"/>
      {% when "chevron-up" %}
        <path d="m18 15-6-6-6 6"/>
      {% when "chevron-left" %}
        <path d="m15 18-6-6 6-6"/>
      {% when "chevron-right" %}
        <path d="m9 18 6-6-6-6"/>
      {% when "hamburger" %}
        <path d="M4 5h16"/><path d="M4 12h16"/><path d="M4 19h16"/>
      {% when "close" %}
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    {% endcase %}
    
</svg>